{
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    },
    "api/server/[id]/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/public/index.html" }
  ],
  "env": {
    "PTERODACTYL_PANEL_URL": "@pterodactyl_panel_url",
    "PTERODACTYL_API_KEY": "@pterodactyl_api_key"
  }
}
