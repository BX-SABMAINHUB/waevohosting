{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/public/index.html",
      "has": [
        {
          "type": "host",
          "value": "www.waevohosting.es"
        }
      ]
    },
    {
      "source": "/dashboard",
      "destination": "/public/dashboard.html",
      "has": [
        {
          "type": "host",
          "value": "panel.waevohosting.es"
        }
      ]
    },
    {
      "source": "/login",
      "destination": "/public/login.html",
      "has": [
        {
          "type": "host",
          "value": "panel.waevohosting.es"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "/public/login.html",
      "has": [
        {
          "type": "host",
          "value": "panel.waevohosting.es"
        }
      ]
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
